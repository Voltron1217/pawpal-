classDiagram
    class Owner {
        +int ownerId
        +String name
        +String phone
        +List~Pet~ pets
        +addPet(pet) void
    }

    class Pet {
        +int petId
        +String name
        +int age
        +String breed
        +float weight
        +List~Scheduling~ appointments
        +List~Task~ tasks
        +scheduleAppointment(appointment) void
        +addTask(task) void
        +isAvailable(on) bool
    }

    class Scheduling {
        +int appointmentId
        +date appointmentDate
        +float payments
        +bool urgent
        +List~Task~ tasks
        +addTask(task) void
    }

    class Task {
        +int taskId
        +String description
        +bool urgent
        +String notesAskQuestionToOwner
        +List~Medicine~ medicines
        +addMedicine(medicine) void
    }

    class Medicine {
        +String name
        +int dosePerDay
        +float cost
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Scheduling : has appointments
    Pet "1" --> "0..*" Task : has tasks
    Scheduling "1" --> "0..*" Task : includes
    Task "1" --> "0..*" Medicine : prescribes
